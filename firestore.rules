rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================================
    // HELPER FUNCTIONS — Role-Based Access Control (RBAC) via Firebase Auth Custom Claims
    // =====================================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role != null && (request.auth.token.role == role || request.auth.token.role.upper() == role || request.auth.token.role.lower() == role.lower());
    }
    
    function isStudent() {
      return hasRole('STUDENT');
    }
    
    function isMentor() {
      return hasRole('MENTOR');
    }
    
    function isHod() {
      return hasRole('HOD');
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAssignedMentor() {
      // Mentor can access records where the mentorEmail matches their logged in Auth account
      return isMentor() && (resource == null || resource.data.mentorEmail == request.auth.token.email);
    }

    function isStudentOwnerOfDoc() {
      // Matches document keys prefixed by user ID or containing explicit studentUid / uid attributes
      return isAuthenticated() && (
        resource == null || 
        resource.data.studentUid == request.auth.uid || 
        resource.data.uid == request.auth.uid
      );
    }

    // =====================================================================================
    // COLLECTION ACCESS RULES (MODULES 1–10)
    // =====================================================================================

    // 1. Users Collection: Student read/write own profile. Mentors and HOD read for verification.
    match /users/{uid} {
      allow read: if isOwner(uid) || isMentor() || isHod();
      allow write: if isOwner(uid);
    }

    // 2. Internships Collection: Core application parameters and working schedules
    match /internships/{uid} {
      allow read: if isOwner(uid) || isAssignedMentor() || isHod();
      allow create: if isOwner(uid) && isStudent();
      allow update: if (isOwner(uid) && isStudent())
                    || (isHod() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'approvalRemarks', 'hodApprovedOn', 'updatedAt', 
                         'approvedAt', 'rejectedAt', 'approvedBy', 'rejectedBy', 'rejectionReason', 'ongoingSince', 'completedAt'
                       ]));
      allow delete: if false; // Audit retention preserves application records
    }

    // 3. Popup Schedule Collection: Daily 5x check-in schedules generated by server Admin SDK
    match /popup_schedule/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isMentor() || isHod());
      allow write: if false; // Written entirely by Spring Boot backend Admin SDK
    }

    // 4. Popups Collection (Root & Pending Subcollection): Working-hour biometric check-ins
    match /popups/{popupId} {
      allow read: if isStudentOwnerOfDoc() || isMentor() || isHod();
      allow create: if false; // Instantiated strictly by backend Service Worker / Admin SDK
      // Student permitted limited response update (verificationResult, status, respondedAt) without overwriting entire document
      allow update: if isAuthenticated() && (
        (resource.data.studentUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationResult', 'respondedAt'])) ||
        (isHod() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedBy', 'remarks', 'updatedAt']))
      );
      allow delete: if false;
    }
    
    match /popups/{uid}/pending/{popupId} {
      allow read: if isOwner(uid) || isMentor() || isHod();
      allow create, delete: if false; // Managed by backend Admin SDK
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationResult', 'respondedAt']);
    }

    // 5. Quotas Collection: Monthly meeting override allowances (5 passes per month)
    match /quotas/{quotaId} {
      allow read: if isAuthenticated() && (quotaId.matches(request.auth.uid + '_.*') || isMentor() || isHod());
      // Students never write directly; decrements occur strictly via server Admin SDK during verification processing
      allow write: if false;
    }

    // 6. Mentor Reviews Collection: Borderline biometric evaluations (40% - 75% facial similarity)
    match /mentor_reviews/{reviewId} {
      allow read: if isMentor() || isHod() || isStudentOwnerOfDoc();
      allow update: if (isMentor() || isHod()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'mentorRemarks', 'resolvedAt', 'resolvedBy']);
      allow create, delete: if false; // Admin SDK generates review triggers
    }

    // 7. Daily Status Collection: Daily attendance and absence summary ledgers
    match /daily_status/{statusId} {
      allow read: if isAuthenticated() && (statusId.matches(request.auth.uid + '_.*') || isMentor() || isHod());
      allow write: if false; // Written automatically by evening compliance reconciliation cron workers
    }

    // 8. Attendance Collection (Module 5b): Daily morning formal attendance mark
    match /attendance/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isStudentOwnerOfDoc() || isMentor() || isHod());
      allow create: if false; // Instantiated by backend morning schedulers
      // Student permitted limited response update when clicking Mark Attendance within authorized window
      allow update: if isAuthenticated() && (
        docId.matches(request.auth.uid + '_.*') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'reason'])
      );
      allow delete: if false;
    }

    // 9. Tests Collection (Module 5c): Biometric proctored examinations and score evaluations
    match /tests/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isStudentOwnerOfDoc() || isMentor() || isHod());
      allow create: if false; // Instantiated by backend test synthesizer
      // Student permitted limited answer submission and anti-cheat tab switch increments during open testing window
      allow update: if isAuthenticated() && (
        docId.matches(request.auth.uid + '_.*') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answers', 'actualStartTime', 'actualSubmitTime', 'tabSwitchCount'])
      );
      allow delete: if false;
    }

    // 10. Diaries Collection (Module 6): Immutable daily work activity logs
    match /diaries/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isStudentOwnerOfDoc() || isMentor() || isHod());
      allow create: if isAuthenticated() && docId.matches(request.auth.uid + '_.*') && isStudent();
      // STRONGLY ENFORCED: Students can create/read own diaries, but never edit after submission (no update rule for students)
      allow update: if (isMentor() || isHod()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationStatus', 'mentorRemarks', 'reviewReason']);
      allow delete: if false;
    }

    // 11. Suspicious Diaries Collection (Module 7): AI Semantic anomaly evaluation flag ledgers
    match /suspicious_diaries/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isStudentOwnerOfDoc() || isMentor() || isHod());
      allow write: if false; // Written entirely by backend AI evaluation engine via Admin SDK
    }

    // 12. Test Questions Collection (Module 5c/7): Cached AI-generated exam question banks
    match /test_questions/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isStudentOwnerOfDoc() || isMentor() || isHod());
      allow write: if false; // Written by backend synthetic exam generator via Admin SDK
    }

    // 13. Warnings Collection (Module 8): Monthly escalation counters & Highlighted disciplinary flags
    match /warnings/{docId} {
      allow read: if isAuthenticated() && (docId.matches(request.auth.uid + '_.*') || isStudentOwnerOfDoc() || isMentor() || isHod());
      allow write: if false; // Read-only for all clients; computed exclusively by backend Admin SDK scheduled worker
    }

    // 14. Completion Summaries Collection (Module 9): Final academic tenure compliance reports
    match /completion_summaries/{uid} {
      allow read: if isOwner(uid) || isMentor() || isHod();
      allow write: if false; // Read-only certification summaries generated by backend Admin SDK lifecycle worker
    }

    // =====================================================================================
    // DEFAULT DENY-ALL FALLBACK RULE — Defense-in-depth protection against unmapped access
    // =====================================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
